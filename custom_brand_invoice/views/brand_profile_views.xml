<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_brand_profile_form" model="ir.ui.view">
        <field name="name">brand.profile.form</field>
        <field name="model">brand.profile</field>
        <field name="arch" type="xml">
            <form string="Commercial Brand">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>

                    <field name="logo" widget="image" class="oe_avatar"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Brand name..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Visual Identity">
                            <field name="primary_color" widget="color"/>
                        </group>
                        <group string="Contact Info">
                            <field name="email"/>
                            <field name="website"/>
                            <field name="phone"/>
                            <field name="vat"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Custom Footer" name="footer">
                            <field name="footer_text"
                                   placeholder="e.g. info@mybrand.com | mybrand.com | +34 600 000 000&#10;Leave empty to auto-build from contact info above."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_brand_profile_list" model="ir.ui.view">
        <field name="name">brand.profile.list</field>
        <field name="model">brand.profile</field>
        <field name="arch" type="xml">
            <list string="Commercial Brands">
                <field name="sequence" widget="handle"/>
                <field name="logo" widget="image" options="{'size': [38, 38]}"/>
                <field name="name"/>
                <field name="email"/>
                <field name="website"/>
                <field name="vat"/>
                <field name="invoice_count" string="Invoices"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_brand_profile" model="ir.actions.act_window">
        <field name="name">Commercial Brands</field>
        <field name="res_model">brand.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU under Invoicing > Configuration -->
    <menuitem id="menu_brand_profile"
              name="Commercial Brands"
              parent="account.menu_finance_configuration"
              action="action_brand_profile"
              sequence="99"/>

</odoo>
